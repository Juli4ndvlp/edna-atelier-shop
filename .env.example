# Base de datos PostgreSQL (opcional en desarrollo; obligatoria en producción).
# En desarrollo, una base vacía usa catálogo de demostración; producción no inserta datos semilla.
# Supabase/Netlify: Transaction pooler (puerto 6543) con ?sslmode=require.
# La conexión directa (5432) es solo para drizzle-kit/psql locales, nunca para la app.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Seguridad del panel /admin (obligatorio en producción; define valores únicos fuera de este archivo).
# En producción: contraseña de al menos 16 caracteres y secreto independiente de al menos 32 caracteres.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cabecera IP elegida solo después de confirmar el proveedor de hosting y su proxy confiable.
# Valores permitidos: x-nf-client-connection-ip (Netlify), x-real-ip (el proxy debe
# sobrescribirla) o x-forwarded-for (el proxy debe quitar valores del cliente y añadir
# la IP real al final). No configurar x-forwarded-for en Netlify.
TRUSTED_CLIENT_IP_HEADER=

# Cron de expiración de reservas (producción; 32+ caracteres, independiente de los otros secretos).
CRON_SECRET=

# URL pública de la web (canonical, sitemap, robots y previsualización social)
NEXT_PUBLIC_SITE_URL=https://edna-atelier-shop.netlify.app

# Número comercial en formato internacional; producción requiere 10-15 dígitos reales (sin el número de demostración).
# El fallback de demostración solo se usa fuera de producción.
# Production requires a real business number with 10-15 digits; the demo fallback is development-only.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# GA4: Measurement ID del flujo web (vacío = tracking desactivado)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Solo para el build independiente Astro; usar el mismo G-... cuando se habilite allí
# PUBLIC_GA_MEASUREMENT_ID=
